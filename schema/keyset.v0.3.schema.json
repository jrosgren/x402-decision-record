{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jrosgren/x402-decision-record/schema/keyset.v0.3.schema.json",
  "title": "Decision-record signing keyset, v0.3-draft",
  "type": "object",
  "required": ["keyset_version", "issuer", "published_at", "keys"],
  "properties": {
    "_note": {"type": "string"},
    "keyset_version": {"const": "0.3-draft"},
    "example_data": {"type": "boolean"},
    "issuer": {"type": "string", "format": "uri"},
    "published_at": {"type": "string"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "alg", "public_key_pem", "valid_from", "valid_until", "status"],
        "properties": {
          "key_id": {"type": "string"},
          "alg": {"const": "Ed25519"},
          "public_key_pem": {"type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----"},
          "valid_from": {"type": "string"},
          "valid_until": {"type": "string"},
          "status": {"enum": ["active", "retired", "revoked"]},
          "revoked_at": {"type": "string"},
          "revocation_reason": {"enum": ["key_compromise", "superseded"]},
          "purpose": {"type": "string"}
        },
        "if": {"properties": {"status": {"const": "revoked"}}},
        "then": {"required": ["revoked_at", "revocation_reason"]}
      }
    }
  }
}
